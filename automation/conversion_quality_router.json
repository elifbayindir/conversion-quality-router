    {
      "id": "ec4b69f1-4329-46ff-8a48-d56f4bd55f1c",
      "name": "Validate Envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const allowedSessionFields = [\"Administrative\", \"Administrative_Duration\", \"Informational\", \"Informational_Duration\", \"ProductRelated\", \"ProductRelated_Duration\", \"BounceRates\", \"ExitRates\", \"SpecialDay\", \"Month\", \"OperatingSystems\", \"Browser\", \"Region\", \"TrafficType\", \"VisitorType\", \"Weekend\"];\n// The Webhook node (v2+) wraps the actual POST body under .body.\nconst body = $input.first().json.body;\nconst errors = [];\n\nconst workflowRequestId = body.workflow_request_id;\nconst idPattern = /^[A-Za-z0-9_-]{1,100}$/;\nif (typeof workflowRequestId !== 'string' || workflowRequestId.length === 0) {\n  errors.push('workflow_request_id is required and must be a non-empty string');\n} else if (!idPattern.test(workflowRequestId)) {\n  errors.push('workflow_request_id must be <=100 chars of [A-Za-z0-9_-]');\n}\n\nconst envelopeKeys = Object.keys(body || {});\nconst unknownEnvelopeKeys = envelopeKeys.filter(k => k !== 'workflow_request_id' && k !== 'session');\nif (unknownEnvelopeKeys.length > 0) {\n  errors.push('Unknown envelope field(s): ' + unknownEnvelopeKeys.join(', '));\n}\n\nconst session = body.session;\nif (typeof session !== 'object' || session === null || Array.isArray(session)) {\n  errors.push('session is required and must be an object');\n} else {\n  const sessionKeys = Object.keys(session);\n  const missing = allowedSessionFields.filter(f => !sessionKeys.includes(f));\n  const unknown = sessionKeys.filter(f => !allowedSessionFields.includes(f));\n  if (missing.length > 0) {\n    errors.push('session is missing required field(s): ' + missing.join(', '));\n  }\n  if (unknown.includes('PageValues')) {\n    errors.push('session must not include PageValues (leakage-risk feature, excluded by design)');\n  }\n  const otherUnknown = unknown.filter(f => f !== 'PageValues');\n  if (otherUnknown.length > 0) {\n    errors.push('session has unknown field(s): ' + otherUnknown.join(', '));\n  }\n}\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    workflow_request_id: workflowRequestId,\n    session: session,\n  },\n}];"
      }
    },
