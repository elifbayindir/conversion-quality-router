    {
      "id": "44a248a9-f434-407a-aee6-7dd785e8906d",
      "name": "Build Automation Fallback (API Error)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        350
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const input = $('Duplicate Check').item.json;\nconst routeResult = $input.first().json;\nconst errMsg = String((routeResult.error && routeResult.error.message) || 'API call failed').slice(0, 300);\n\nreturn [{\n  json: {\n    workflow_request_id: input.workflow_request_id,\n    model_request_id: null,\n    decision: 'SYSTEM_FALLBACK',\n    priority: 'HIGH',\n    allowed_action: 'ADD_TO_REVIEW_QUEUE',\n    requires_human_approval: true,\n    reason_codes: ['AGENT_UNAVAILABLE'],\n    explanation: 'Automation could not reach the prediction/decision API: ' + errMsg,\n    agent_version: null,\n    schema_version: null,\n    origin: 'automation_error',\n  },\n}];"
      }
    },
    {
      "id": "cd8119a7-0863-47ef-b5a2-c1e93a943152",
      "name": "Validate Decision Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        550
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const required = [\"request_id\", \"decision\", \"priority\", \"allowed_action\", \"requires_human_approval\", \"reason_codes\", \"explanation\", \"agent_version\", \"schema_version\"];\nconst validDecisions = [\"LOG_ONLY\", \"PRIORITY_REVIEW\", \"HUMAN_REVIEW\", \"SYSTEM_FALLBACK\"];\nconst validPriorities = [\"LOW\", \"MEDIUM\", \"HIGH\"];\nconst validActions = [\"ADD_TO_LOG\", \"ADD_TO_REVIEW_QUEUE_PRIORITY\", \"ADD_TO_REVIEW_QUEUE\"];\nconst actionForDecision = {\"LOG_ONLY\": \"ADD_TO_LOG\", \"PRIORITY_REVIEW\": \"ADD_TO_REVIEW_QUEUE_PRIORITY\", \"HUMAN_REVIEW\": \"ADD_TO_REVIEW_QUEUE\"};\n\nconst routeResult = $input.first().json;\nconst resp = routeResult.response || {};\nconst errors = [];\n\nfor (const field of required) {\n  if (!(field in resp)) errors.push('missing field: ' + field);\n}\n\nconst decision = resp.decision;\n// n8n never accepts SYSTEM_FALLBACK as if it were a real API decision --\n// FastAPI's own agent never emits it as a *fresh* success case; a\n// SYSTEM_FALLBACK arriving here is the agent's OWN deterministic fallback,\n// which is a legitimate, already-safe decision and passes through like any\n// other value in validDecisions. What must never happen is an invented\n// value outside this closed set.\nif (decision !== undefined && !validDecisions.includes(decision)) {\n  errors.push('unknown decision: ' + decision);\n}\nif (resp.priority !== undefined && !validPriorities.includes(resp.priority)) {\n  errors.push('unknown priority: ' + resp.priority);\n}\nif (resp.allowed_action !== undefined && !validActions.includes(resp.allowed_action)) {\n  errors.push('unknown allowed_action: ' + resp.allowed_action);\n}\nif (decision && actionForDecision[decision] && resp.allowed_action !== actionForDecision[decision]) {\n  errors.push('decision/allowed_action mismatch: ' + decision + ' requires ' + actionForDecision[decision]);\n}\nif (resp.requires_human_approval !== undefined && typeof resp.requires_human_approval !== 'boolean') {\n  errors.push('requires_human_approval must be boolean');\n}\nif (Array.isArray(resp.reason_codes) && resp.reason_codes.length === 0) {\n  errors.push('reason_codes must not be empty');\n}\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    response: resp,\n  },\n}];"
      }
    },
