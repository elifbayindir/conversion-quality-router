    {
      "id": "8733cc1d-8f44-46b9-82fc-2bac21ac7274",
      "name": "Duplicate Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        400
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const MAX_ENTRIES = 500;\nconst TTL_MS = 24 * 60 * 60 * 1000; // 24h bound, documented in docs/n8n-workflow.md\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.seenRequestIds) {\n  staticData.seenRequestIds = {};\n}\n\nconst now = Date.now();\nconst seen = staticData.seenRequestIds;\n\n// Evict expired entries first (bounded TTL, not unbounded growth).\nfor (const key of Object.keys(seen)) {\n  if (now - seen[key] > TTL_MS) {\n    delete seen[key];\n  }\n}\n\nconst input = $input.first().json;\nconst id = input.workflow_request_id;\nconst isDuplicate = Object.prototype.hasOwnProperty.call(seen, id);\n\nif (!isDuplicate) {\n  seen[id] = now;\n  // Bound total memory: drop the oldest entries once over the cap.\n  const keys = Object.keys(seen);\n  if (keys.length > MAX_ENTRIES) {\n    const sorted = keys.sort((a, b) => seen[a] - seen[b]);\n    const toDrop = sorted.slice(0, keys.length - MAX_ENTRIES);\n    for (const k of toDrop) delete seen[k];\n  }\n}\n\nreturn [{\n  json: {\n    isDuplicate,\n    workflow_request_id: input.workflow_request_id,\n    session: input.session,\n  },\n}];"
      }
    },
