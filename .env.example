# Copy this file to .env and fill in real values locally.
# Never commit .env or real secret values.

# Anthropic Claude API key for the LLM decision agent (see docs/architecture.md).
ANTHROPIC_API_KEY=

# Slack/Discord incoming webhook URL used by the n8n workflow's real external action.
N8N_NOTIFY_WEBHOOK_URL=

# Optional: FastAPI bind host/port overrides (defaults: 127.0.0.1 / 8000).
API_HOST=
API_PORT=
